<Window x:Class="EconomicsNEA.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Up"
        Height="350" Width="350"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel Width="250" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Create Account"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Username"/>
            <TextBox x:Name="NewUsername" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="NewPassword" Height="30" Margin="0,0,0,10"/>
              
            <TextBlock Text="Confirm Password"/>
            <PasswordBox x:Name="ConfirmPassword" Height="30" Margin="0,0,0,20"/>

            <Button Content="Sign Up"
                    Height="35"
                    Background="#0078D7"
                    Foreground="White"
                    Click="SignUpClickd"/>
        </StackPanel>
    </Grid>
</Window>
