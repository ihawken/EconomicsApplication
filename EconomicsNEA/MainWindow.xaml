<Window x:Class="EconomicsNEA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EconomicsNEA"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Economics Help Software" 
               VerticalAlignment="Top"
               HorizontalAlignment="Center"
               FontSize="25" Margin="0,37,0,0"
/>
        <Button Content="Graphs"
                Width="200"
                Height="50" Margin="350,267,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Click="Graph_Click"
                />
        <Button Content="Flashcards"
                Width="200"
                Height="50" Margin="595,267,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"


                />
        <Button Content="Notes"
                Width="200"
                Height="50" Margin="109,267,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                />
        <TextBlock FontSize =" 20" HorizontalAlignment="Center" Margin="0,221,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="en-gb" Text="Which do you want help with today?"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="6,-50,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>

    </Grid>

</Window>
