<Window x:Class="EconomicsNEA.GraphRender"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EconomicsNEA"
        mc:Ignorable="d"
        Title="GraphRender" Height="550" Width="800">
    <Grid x:Name="MainGrid" ShowGridLines="True">
        <TextBlock Text="Supply and Demand"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   FontSize="30">
        </TextBlock>
        <Grid x:Name="DiagramGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,206,0,0" Height="306" Width="527">
            <Grid.RowDefinitions>
                <RowDefinition Height="0*"/>
                <RowDefinition Height="53*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>

            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform X="100" Y="-100"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Line Stroke="Black" StrokeThickness="5"
                  x:Name="axisY"
              X1="80"
              Y1="278.5"
              Y2="0"
              X2="80"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left" Width="87" Margin="-20,-6,0,0" Height="300" Grid.Row="1" Grid.RowSpan="2"
             />

            <Line Stroke="Black" StrokeThickness="5"
                  x:Name="axisX"
                 X1="600"
                Y1="270"
                 Y2="270"
                 X2="91"
                 VerticalAlignment="Top"
            HorizontalAlignment="Left" Width="510" Margin="-33,0,0,0" Height="300" Grid.Row="1" Grid.RowSpan="2"
                  
            />
            <Label x:Name="XaxisName" Content="Xaxis" HorizontalAlignment="Left" Margin="402,4,0,0" Grid.Row="2" VerticalAlignment="Top" Width="74"/>
            <Label x:Name="YaxisName" Content="Yaxis" HorizontalAlignment="Left" Margin="10,10,0,0" Grid.Row="1" VerticalAlignment="Top" Width="45"/>
            <Grid x:Name="RestraintForLines" Margin="63,-71,0,3" Grid.RowSpan="2">
                
            </Grid>
        </Grid>
    </Grid>
</Window>
