<Window x:Class="EconomicsNEA.Graphs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EconomicsNEA"
        mc:Ignorable="d"
        Title="Graphs" Height="600" Width="900">
    <Grid>
        <TextBlock Text="Graphs" 
               VerticalAlignment="Top"
               HorizontalAlignment="Center"
               FontSize="25" Margin="0,37,0,0"
/>
        <TextBlock Text="Micro" 
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               FontSize="25" Margin="200,100,0,0"
/>
        <Button Content="Supply and Demand" 
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               FontSize="25" Margin="118,159,0,0" Click="Supply_Demand_Click"
/>
        <TextBlock Text="Macro" 
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               FontSize="25" Margin="600,100,0,0"
/>
    </Grid>
</Window>
